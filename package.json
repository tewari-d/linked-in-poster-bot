{
  "name": "sap-linkedin-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Drafts a daily SAP-technical LinkedIn post, sends it for approval on Telegram, posts on approval.",
  "type": "commonjs",
  "main": "src/cli/draft.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/app.js",
    "draft": "node src/cli/draft.js",
    "models": "node src/cli/models.js",
    "telegram:setup": "node src/cli/telegramSetup.js",
    "phone:bundle": "node src/cli/phoneBundle.js",
    "test": "node --test",
    "secrets:check": "node src/cli/checkSecrets.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "opentype.js": "^2.0.0"
  }
}
