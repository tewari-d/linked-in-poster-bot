# Copy to .env and fill in. Never commit .env.

# --- Gemini (post text + image prompt) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# After setting the key, run `npm run models` and pick a current model that supports generateContent.
GEMINI_MODEL=

# --- Telegram (approval chat) ---
# From @BotFather. Treat it like a password: whoever has it controls the bot.
TELEGRAM_BOT_TOKEN=
# Your own chat id; the bot ignores everyone else. Tap Start in the bot, then run `npm run telegram:setup`.
TELEGRAM_OWNER_CHAT_ID=

# --- Scheduling / topics ---
TIMEZONE=Asia/Kolkata
# Daily draft time, and the latest time a missed draft is still sent (e.g. laptop asleep at 09:00).
SEND_TIME=09:00
CATCHUP_CUTOFF=12:00
# Posting is simulated unless this is exactly "false". Connect LinkedIn first (/linkedin works in dry run too).
DRY_RUN=true
# Day 0 of the topic rotation. Changing it shifts which topic falls on which day.
TOPIC_EPOCH_DATE=2026-11-01
# Optional. The AI disclaimer line placed between the post and its hashtags. Leave it out for the default
# ("🤖 AI Generated Content, curated by a human. Spot something off? Tell me in the comments 👇"); set it empty to drop the line.
# POST_DISCLAIMER=

# Optional. The bot draws each draft's image (an infographic with the exact text from the post).
# Set to "false" to go back to making the image yourself from the image idea.
# AUTO_IMAGE=true

# --- LinkedIn (posting) ---
# From https://www.linkedin.com/developers/apps → your app → Auth tab. The secret is a password: never share it.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Must match the app's "Authorized redirect URL" exactly. Default:
# LINKEDIN_REDIRECT_URI=http://localhost:8765/auth/linkedin/callback
# Optional. LinkedIn API version (YYYYMM); each is supported for at least a year. Default:
# LINKEDIN_API_VERSION=202610

# --- Storage ---
DATA_DIR=./data
